{
    "name": "koh/poppy",
    "description": "Framework-agnostic server core for the Personal Agent Protocol (Poppy): poppy.json discovery, issuer binding, agent identity, DPoP, Sessions, Direct and Device Sign-In, Account Tokens.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "poppy",
        "personal-agent-protocol",
        "ai-agent",
        "oauth",
        "dpop",
        "psr-7"
    ],
    "authors": [
        {
            "name": "Kai Ole Hartwig",
            "email": "mail@ole-hartwig.eu"
        }
    ],
    "homepage": "https://ole-hartwig.eu/open-source",
    "support": {
        "issues": "https://git.ole-hartwig.eu/ai-ready-platform/platform/poppy/-/issues",
        "source": "https://github.com/ohartwig/poppy"
    },
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-sodium": "*",
        "psr/clock": "^1.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0"
    },
    "require-dev": {
        "infection/infection": "^0.35.4",
        "nyholm/psr7": "^1.8",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5 || ^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "Koh\\Poppy\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Koh\\Poppy\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0-dev"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    }
}
